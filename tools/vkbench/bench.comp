#version 450
// Pipeline-compilation workload for vkbench.
//
// VARIANT is a specialization constant, so every value produces genuinely
// different unrolled code and a distinct compile. Using one module with N
// spec values, rather than N modules, keeps the SPIR-V embedded in the binary
// small while still forcing N real compilations.
layout(local_size_x = 64) in;
layout(constant_id = 0) const int VARIANT = 1;
layout(std430, binding = 0) buffer Data { float v[]; } data;

void main() {
    uint i = gl_GlobalInvocationID.x;
    float acc = data.v[i];
    for (int k = 0; k < VARIANT; k++) {
        acc = fma(acc, 1.000001, float(k) * 0.5);
        acc = sqrt(abs(acc)) + sin(acc);
        if ((k & 3) == 0)      acc *= 1.5;
        else if ((k & 3) == 1) acc -= 0.25;
        else                   acc = mix(acc, acc * acc, 0.125);
    }
    data.v[i] = acc;
}
